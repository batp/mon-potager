# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bandeau placeholders (staging)
NEXT_PUBLIC_SHOW_PLACEHOLDER_BANNER=true

# Web Push (optionnel — après build PWA)
# Générer : npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@monpotager.app

# Cron rappels push (route /api/cron/push-reminders)
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
